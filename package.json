{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds fresh SDE roles in Bangalore, Hyderabad and Pune straight from company career pages, scores them, and lists them on a Cloudflare-hosted dashboard.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply job-radar --remote",
    "db:migrate:local": "wrangler d1 migrations apply job-radar --local",
    "poll": "tsx --env-file-if-exists=.env src/poller.ts",
    "poll:local": "tsx src/poller.ts --local",
    "probe": "tsx --env-file-if-exists=.env src/scripts/probe.ts",
    "dry-run": "tsx --env-file-if-exists=.env src/scripts/dry-run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
