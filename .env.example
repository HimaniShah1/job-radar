# Used by `npm run poll` (and the GitHub Action, as repository secrets of the same names).
# Account ID: Cloudflare dashboard > Workers & Pages (right sidebar).
CLOUDFLARE_ACCOUNT_ID=
# From `npx wrangler d1 create job-radar` (also in wrangler.jsonc).
D1_DATABASE_ID=
# My Profile > API Tokens > Create custom token, permission "Account > D1 > Edit" only.
CLOUDFLARE_API_TOKEN=

POLL_CONCURRENCY=6
