# Postgres. Local: `docker compose up -d` gives you this URL.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar

# Telegram: message @BotFather -> /newbot -> paste the token here.
# Then send your bot any message and open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling
POLL_INTERVAL_MIN=20
POLL_CONCURRENCY=6
MAX_ALERT_AGE_HOURS=72

# Dashboard. Set a password before exposing it beyond localhost.
PORT=3000
HOST=127.0.0.1
DASHBOARD_URL=http://localhost:3000
DASHBOARD_USER=
DASHBOARD_PASSWORD=
