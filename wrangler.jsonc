// Cloudflare Worker for the dashboard (Workers Free plan is enough for this part).
// Polling runs in GitHub Actions instead; see .github/workflows/poll.yml for why.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-radar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The page goes through the Worker's Access check too, not just the API.
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      // The code reads env.DB, so keep this binding name and keep exactly one entry:
      // `wrangler d1 create` offers to append its own; put the id here instead.
      "binding": "DB",
      "database_name": "job-radar",
      // From `npx wrangler d1 create job-radar`. Not a secret.
      "database_id": "d91da556-c381-4859-99b2-aed8d562b444",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Zero Trust > Settings > Custom pages shows your team domain; the AUD tag is on the Access application.
    "ACCESS_TEAM_DOMAIN": "theshiplog.cloudflareaccess.com",
    "ACCESS_AUD": "06c882a5fd554708a412353beb4e5469d83accf1053a3b5bb9dffd4c7d6e1f39",
  },
  "observability": {
    "enabled": true,
  },
}
