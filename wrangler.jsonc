// Cloudflare Worker for the dashboard (Workers Free plan is enough for this part).
// Polling runs in GitHub Actions instead; see .github/workflows/poll.yml for why.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-radar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The page goes through the Worker's Access check too, not just the API.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-radar",
      // From `npx wrangler d1 create job-radar`. Not a secret.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Zero Trust > Settings > Custom pages shows your team domain; the AUD tag is on the Access application.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
